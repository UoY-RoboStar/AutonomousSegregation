<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stc_driver</name>
  <version>0.1.0</version>
  <description>Test driver that replays .rtspec forbidden traces against a ROS 2 SUT on simulated time</description>
  <maintainer email="kumaracharjee@outlook.com">Kumar</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>std_msgs</depend>
  <depend>driver_interface</depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
