<?xml version="1.0"?>
<!-- GUI configuration for consistent visualisation accross gazebo installations. -->
<dialog name="quick_start" show_again="false"/>
<window>
  <width>1000</width>
  <height>845</height>
  <menus>
    <drawer visible="false" default="false"/>
    <plugins visible="false" from_paths="false"/>
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <!-- Complete 7.25 x 6.25 m arena fits in a 16:9 fullscreen viewport. -->
  <camera_pose>-0.5 0 8.5 0 1.5707963267948966 0</camera_pose>
</plugin>
<plugin filename="MarkerManager" name="Selected robot highlight">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="visible" type="bool">false</property>
  </gz-gui>
  <topic_name>/cachecons/selection_marker</topic_name>
  <warn_on_action_failure>false</warn_on_action_failure>
</plugin>

<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="visible" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="visible" type="bool">false</property>
  </gz-gui>
</plugin>
